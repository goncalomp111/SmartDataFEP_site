---
/**
 * Wizard do questionário "Descobre o teu Departamento".
 *
 * As perguntas são renderizadas no servidor (uma secção por pergunta) e o
 * script do lado do cliente limita-se a mostrar uma de cada vez, guardar as
 * respostas e construir o ecrã de resultados. Toda a definição das perguntas
 * e a pontuação vivem em src/data/questionario.ts.
 */
import {
  PERGUNTAS,
  ESCALAS,
  INSTRUCOES,
  valorDaOpcao,
} from '../data/questionario';

const total = PERGUNTAS.length;
---

<section id="questionario" class="bg-gray-50 py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4 md:px-6">
    <div
      class="rounded-2xl border border-gray-100 bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)]"
    >
      <!-- ================= Ecrã inicial ================= -->
      <div id="q-intro" class="px-6 py-12 text-center md:px-14 md:py-16">
        <div class="mb-6 inline-block border-l-4 border-blue-400 pl-4 text-left">
          <span
            class="text-xs font-semibold uppercase tracking-widest text-indigo-400 md:text-sm"
            >Antes de começares</span
          >
        </div>
        <h2 class="mb-5 text-2xl font-bold text-[#1e1b4b] md:text-4xl">
          {total} perguntas. Menos de 5 minutos.
        </h2>
        <p class="mx-auto mb-8 max-w-xl text-base leading-relaxed text-gray-600 md:text-lg">
          Não há respostas certas nem erradas, e nada disto é um teste técnico.
          Responde com o que te sai naturalmente — é assim que o resultado fica
          mais próximo de ti.
        </p>
        <button
          type="button"
          id="q-comecar"
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-[#1e1b4b] px-8 py-4 font-bold text-white transition-all hover:shadow-[0_8px_24px_rgba(30,27,75,0.25)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e1b4b]"
        >
          <span class="relative z-10">Começar questionário</span>
          <svg
            class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </button>
        <p class="mt-6 text-sm text-gray-400">
          As respostas ficam no teu navegador. Não guardamos nada.
        </p>
      </div>

      <!-- ================= Formulário ================= -->
      <div id="q-form" hidden>
        <!-- Barra de progresso -->
        <div class="border-b border-gray-100 px-6 pt-8 pb-6 md:px-14">
          <div class="mb-3 flex items-baseline justify-between">
            <span
              class="text-xs font-bold uppercase tracking-widest text-indigo-400"
            >
              Pergunta <span id="q-atual">1</span> de {total}
            </span>
            <span id="q-percentagem" class="text-sm font-medium text-gray-400"
              >0%</span
            >
          </div>
          <div
            class="h-2 w-full overflow-hidden rounded-full bg-gray-100"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax={total}
            aria-valuenow="1"
            aria-label="Progresso do questionário"
            id="q-barra-wrapper"
          >
            <div
              id="q-barra"
              class="h-full rounded-full bg-gradient-to-r from-[#1e1b4b] to-indigo-400 transition-[width] duration-500 ease-out"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Passos -->
        <div class="px-6 py-10 md:px-14 md:py-12">
          {
            PERGUNTAS.map((pergunta, indice) => (
              <fieldset
                class="q-step"
                data-step={indice}
                data-pergunta={pergunta.id}
                hidden
              >
                <legend class="mb-2 block text-sm font-semibold uppercase tracking-wide text-indigo-400">
                  {INSTRUCOES[pergunta.escala]}
                </legend>
                <p class="mb-8 text-xl font-semibold leading-snug text-[#1e1b4b] md:text-2xl">
                  {pergunta.texto}
                </p>

                <div class="space-y-3">
                  {ESCALAS[pergunta.escala].map((rotulo, i) => (
                    <label class="group flex cursor-pointer items-center gap-4 rounded-xl border-2 border-gray-200 bg-white px-5 py-4 transition-all duration-200 hover:border-indigo-300 hover:bg-indigo-50/40 has-[:checked]:border-[#1e1b4b] has-[:checked]:bg-[#1e1b4b] has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-[#1e1b4b]">
                      <input
                        type="radio"
                        name={pergunta.id}
                        value={valorDaOpcao(pergunta.escala, i)}
                        class="sr-only"
                      />
                      <span
                        aria-hidden="true"
                        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-gray-200 text-sm font-bold text-gray-400 transition-colors group-hover:border-indigo-300 group-has-[:checked]:border-white group-has-[:checked]:bg-white group-has-[:checked]:text-[#1e1b4b]"
                      >
                        {pergunta.escala === 'simNao' ? (i === 0 ? 'N' : 'S') : i + 1}
                      </span>
                      <span class="text-base font-medium text-[#1e1b4b] transition-colors group-has-[:checked]:text-white md:text-lg">
                        {rotulo}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))
          }

          <p
            id="q-aviso"
            class="mt-6 text-sm font-medium text-red-600"
            role="alert"
            hidden
          >
            Escolhe uma opção para continuares.
          </p>
        </div>

        <!-- Navegação -->
        <div
          class="flex items-center justify-between gap-4 border-t border-gray-100 px-6 py-6 md:px-14"
        >
          <button
            type="button"
            id="q-anterior"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-6 py-3 font-medium text-[#1e1b4b] transition-colors hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e1b4b] disabled:cursor-not-allowed disabled:opacity-40"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg
            >
            Anterior
          </button>

          <span class="hidden text-sm text-gray-400 sm:block">
            Podes usar as teclas 1 a 5
          </span>

          <button
            type="button"
            id="q-seguinte"
            class="inline-flex items-center gap-2 rounded-full bg-[#1e1b4b] px-7 py-3 font-bold text-white transition-all hover:shadow-[0_8px_24px_rgba(30,27,75,0.25)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e1b4b]"
          >
            Seguinte
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg
            >
          </button>
        </div>
      </div>

      <!-- ================= Resultado ================= -->
      <div
        id="q-resultado"
        class="px-6 py-12 md:px-14 md:py-16"
        tabindex="-1"
        hidden
      >
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrada suave de cada pergunta. O atributo [hidden] continua a esconder
     por completo, por isso a animação só corre no passo visível. */
  .q-step {
    animation: q-entrar 0.35s ease-out;
  }

  @keyframes q-entrar {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-step {
      animation: none;
    }
  }
</style>

<script>
  import {
    PERGUNTAS,
    ORDEM_DEPARTAMENTOS,
    calcularResultado,
    fraseDePerfil,
    type Resultado,
  } from '../data/questionario';

  const intro = document.getElementById('q-intro');
  const form = document.getElementById('q-form');
  const painelResultado = document.getElementById('q-resultado');
  const passos = Array.from(
    document.querySelectorAll<HTMLElement>('.q-step'),
  );
  const barra = document.getElementById('q-barra');
  const barraWrapper = document.getElementById('q-barra-wrapper');
  const rotuloAtual = document.getElementById('q-atual');
  const rotuloPercentagem = document.getElementById('q-percentagem');
  const aviso = document.getElementById('q-aviso');
  const botaoComecar = document.getElementById('q-comecar');
  const botaoAnterior = document.getElementById(
    'q-anterior',
  ) as HTMLButtonElement | null;
  const botaoSeguinte = document.getElementById(
    'q-seguinte',
  ) as HTMLButtonElement | null;

  // Sem os elementos essenciais não há nada a fazer.
  if (form && painelResultado && passos.length > 0) {
    const total = passos.length;
    const respostas: Record<string, number> = {};
    let indice = 0;

    const semAnimacao = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    // ---------------------------------------------------------------
    // Navegação
    // ---------------------------------------------------------------

    function mostrarPasso(novo: number) {
      indice = Math.max(0, Math.min(total - 1, novo));

      passos.forEach((passo, i) => {
        passo.hidden = i !== indice;
      });

      const concluidas = Object.keys(respostas).length;
      const percentagem = Math.round((concluidas / total) * 100);

      if (barra) barra.style.width = `${percentagem}%`;
      if (rotuloAtual) rotuloAtual.textContent = String(indice + 1);
      if (rotuloPercentagem) rotuloPercentagem.textContent = `${percentagem}%`;
      if (barraWrapper)
        barraWrapper.setAttribute('aria-valuenow', String(indice + 1));
      if (botaoAnterior) botaoAnterior.disabled = indice === 0;
      if (botaoSeguinte)
        botaoSeguinte.textContent = indice === total - 1 ? 'Ver resultado' : 'Seguinte';

      esconderAviso();

      // Move o foco para a pergunta, para quem navega por teclado ou leitor de ecrã.
      const legenda = passos[indice].querySelector('p');
      legenda?.setAttribute('tabindex', '-1');
      legenda?.focus({ preventScroll: true });
    }

    function esconderAviso() {
      if (aviso) aviso.hidden = true;
    }

    function respostaAtual(): number | undefined {
      return respostas[passos[indice].dataset.pergunta ?? ''];
    }

    function avancar() {
      if (respostaAtual() === undefined) {
        if (aviso) aviso.hidden = false;
        return;
      }
      if (indice === total - 1) {
        mostrarResultado();
      } else {
        mostrarPasso(indice + 1);
      }
    }

    // ---------------------------------------------------------------
    // Respostas
    // ---------------------------------------------------------------

    form.addEventListener('change', (evento) => {
      const alvo = evento.target as HTMLInputElement;
      if (alvo.type !== 'radio') return;

      respostas[alvo.name] = Number(alvo.value);
      esconderAviso();

      // Avanço automático, com uma pausa curta para se ver a opção escolhida.
      const ultima = indice === total - 1;
      window.setTimeout(
        () => {
          if (ultima) mostrarResultado();
          else mostrarPasso(indice + 1);
        },
        semAnimacao ? 0 : 260,
      );
    });

    // Teclas 1 a 5 (e S/N nas perguntas de sim ou não).
    document.addEventListener('keydown', (evento) => {
      if (form.hidden) return;
      if (evento.metaKey || evento.ctrlKey || evento.altKey) return;

      const opcoes = Array.from(
        passos[indice].querySelectorAll<HTMLInputElement>('input[type="radio"]'),
      );

      const numero = Number(evento.key);
      let escolhida: HTMLInputElement | undefined;

      if (numero >= 1 && numero <= opcoes.length) {
        escolhida = opcoes[numero - 1];
      } else if (opcoes.length === 2) {
        const tecla = evento.key.toLowerCase();
        if (tecla === 'n') escolhida = opcoes[0];
        if (tecla === 's') escolhida = opcoes[1];
      }

      if (escolhida) {
        evento.preventDefault();
        escolhida.checked = true;
        escolhida.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });

    botaoSeguinte?.addEventListener('click', avancar);
    botaoAnterior?.addEventListener('click', () => mostrarPasso(indice - 1));

    botaoComecar?.addEventListener('click', () => {
      if (intro) intro.hidden = true;
      form.hidden = false;
      mostrarPasso(0);
      form.scrollIntoView({
        behavior: semAnimacao ? 'auto' : 'smooth',
        block: 'start',
      });
    });

    // ---------------------------------------------------------------
    // Resultado
    // ---------------------------------------------------------------

    function barraDepartamento(
      sigla: string,
      nome: string,
      afinidade: number,
      destacado: boolean,
    ): string {
      return `
        <div class="flex items-center gap-3 md:gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 text-[11px] font-bold ${
            destacado
              ? 'border-[#1e1b4b] bg-[#1e1b4b] text-white'
              : 'border-gray-200 text-gray-400'
          }">${sigla}</span>
          <div class="min-w-0 flex-1">
            <div class="mb-1 flex items-baseline justify-between gap-2">
              <span class="truncate text-sm font-medium ${
                destacado ? 'text-[#1e1b4b]' : 'text-gray-500'
              }">${nome}</span>
              <span class="shrink-0 text-sm font-bold ${
                destacado ? 'text-[#1e1b4b]' : 'text-gray-400'
              }">${afinidade}%</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-100">
              <div class="h-full rounded-full ${
                destacado
                  ? 'bg-gradient-to-r from-[#1e1b4b] to-indigo-400'
                  : 'bg-gray-300'
              }" style="width: ${afinidade}%"></div>
            </div>
          </div>
        </div>`;
    }

    function htmlResultado(resultado: Resultado): string {
      const { principal, secundario, ranking, tracosFortes } = resultado;
      const afinidadePrincipal =
        ranking.find((r) => r.departamento.id === principal.id)?.afinidade ?? 0;
      const destacados = new Set([principal.id, secundario?.id]);

      const blocoSecundario = secundario
        ? `
        <div class="mt-8 rounded-xl border-l-4 border-blue-400 bg-blue-50/60 p-6">
          <p class="mb-2 text-xs font-bold uppercase tracking-widest text-indigo-400">
            Muito perto disso
          </p>
          <h4 class="mb-2 text-lg font-bold text-[#1e1b4b]">${secundario.nome}</h4>
          <p class="text-base leading-relaxed text-gray-600">
            ${secundario.resumo} A tua pontuação nestes dois departamentos ficou
            praticamente empatada, o que costuma acontecer a quem tem um perfil
            versátil. Vale a pena conheceres os dois antes de decidires.
          </p>
        </div>`
        : '';

      return `
        <div class="text-center">
          <div class="mb-6 inline-block border-l-4 border-blue-400 pl-4 text-left">
            <span class="text-xs font-semibold uppercase tracking-widest text-indigo-400 md:text-sm">
              O teu resultado
            </span>
          </div>

          <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-[#1e1b4b] text-2xl font-bold text-white shadow-2xl">
            ${principal.sigla}
          </div>

          <h3 class="mb-3 text-3xl font-bold text-[#1e1b4b] md:text-4xl">
            ${principal.nome}
          </h3>
          <p class="mb-8 text-lg font-light text-gray-500">
            ${afinidadePrincipal}% de afinidade &middot; ${fraseDePerfil(tracosFortes)}
          </p>
        </div>

        <p class="mb-6 text-base leading-relaxed text-gray-700 md:text-lg">
          ${principal.porque}
        </p>
        <p class="mb-8 border-l-2 border-gray-200 pl-4 text-base leading-relaxed text-gray-500">
          ${principal.descricao}
        </p>

        ${blocoSecundario}

        <div class="mt-10 border-t border-gray-100 pt-8">
          <h4 class="mb-6 text-sm font-bold uppercase tracking-widest text-indigo-400">
            Afinidade com cada departamento
          </h4>
          <div class="space-y-4">
            ${ranking
              .map((linha) =>
                barraDepartamento(
                  linha.departamento.sigla,
                  linha.departamento.nome,
                  linha.afinidade,
                  destacados.has(linha.departamento.id),
                ),
              )
              .join('')}
          </div>
        </div>

        <p class="mt-10 rounded-xl bg-gray-50 p-6 text-center text-base leading-relaxed text-gray-600">
          Isto é uma sugestão, não uma colocação. Muitos dos nossos membros
          acabaram num departamento diferente daquele que esperavam — e foi
          a melhor decisão que tomaram. Usa o resultado como ponto de partida
          e mantém a mente aberta.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/equipa?scrollTo=${principal.ancora}"
             class="inline-flex items-center justify-center gap-2 rounded-full bg-[#1e1b4b] px-8 py-4 font-bold text-white transition-all hover:shadow-[0_8px_24px_rgba(30,27,75,0.25)]">
            Conhecer a equipa de ${principal.nome}
          </a>
          <button type="button" id="q-repetir"
             class="inline-flex items-center justify-center gap-2 rounded-full border border-[#1e1b4b] px-8 py-4 font-bold text-[#1e1b4b] transition-colors hover:bg-blue-50">
            Repetir questionário
          </button>
        </div>`;
    }

    function mostrarResultado() {
      const resultado = calcularResultado(respostas);

      painelResultado!.innerHTML = htmlResultado(resultado);
      form!.hidden = true;
      painelResultado!.hidden = false;
      painelResultado!.focus({ preventScroll: true });
      painelResultado!.scrollIntoView({
        behavior: semAnimacao ? 'auto' : 'smooth',
        block: 'start',
      });

      document.getElementById('q-repetir')?.addEventListener('click', () => {
        for (const chave of Object.keys(respostas)) delete respostas[chave];
        form!
          .querySelectorAll<HTMLInputElement>('input[type="radio"]')
          .forEach((entrada) => {
            entrada.checked = false;
          });
        painelResultado!.hidden = true;
        painelResultado!.innerHTML = '';
        form!.hidden = false;
        mostrarPasso(0);
        form!.scrollIntoView({
          behavior: semAnimacao ? 'auto' : 'smooth',
          block: 'start',
        });
      });
    }

    // Aviso em consola se os dados e o HTML deixarem de bater certo.
    if (PERGUNTAS.length !== total || ORDEM_DEPARTAMENTOS.length !== 6) {
      console.warn('[questionario] Dados e marcação fora de sincronia.');
    }
  }
</script>
