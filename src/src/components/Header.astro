<header class="bg-indigo-950 text-white">
  <div class="flex h-20 items-center justify-between px-6 md:px-10 w-[87%] mx-auto py-4">
    <div class="flex items-center gap-3">
      <a href="/">
        <img src="/favicon.svg" alt="SmartData Logo" width="40" height="40" class="min-w-[40px] min-h-[40px]" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-5 text-lg lg:gap-8 lg:text-xl md:flex">
      <a class="transition hover:text-indigo-200" href="/">Home</a>
      <a class="transition hover:text-indigo-200" href="/sobre">Sobre</a>
      <a class="transition hover:text-indigo-200" href="/equipa">Equipa</a>
      <a class="transition hover:text-indigo-200" href="/serviços">Serviços</a>
      <a class="transition hover:text-indigo-200" href="/eventos">Eventos</a>
      <a class="transition hover:text-indigo-200" href="/contactos">Contactos</a>
      <a
        class="rounded-full bg-white/10 px-4 py-2 text-base whitespace-nowrap ring-1 ring-white/25 transition hover:bg-white/20 lg:text-lg"
        href="/questionario">Junta-te</a
      >
    </nav>

    <!-- Mobile Hamburger Button -->
    <button 
      id="mobile-menu-button" 
      class="md:hidden flex flex-col gap-1.5 p-2 focus:outline-none focus:ring-2 focus:ring-indigo-300 rounded"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <div 
    id="mobile-overlay" 
    class="md:hidden fixed inset-0 bg-black/40 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
  ></div>

  <!-- Mobile Side Menu -->
  <nav 
    id="mobile-menu" 
    class="md:hidden fixed top-0 right-0 h-full w-64 bg-indigo-900 z-50 translate-x-full transition-transform duration-300 ease-in-out shadow-2xl"
  >
    <div class="flex flex-col h-full">
      <!-- Close button -->
      <div class="flex justify-between items-center px-6 py-5 border-b border-indigo-800">
        <span class="text-xl font-semibold">Menu</span>
        <button 
          id="close-menu-button" 
          class="p-2 hover:bg-indigo-800 rounded transition"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <!-- Menu items -->
      <div class="flex flex-col px-6 py-6 space-y-4">
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/">Home</a>
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/sobre">Sobre</a>
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/equipa">Equipa</a>
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/serviços">Serviços</a>
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/eventos">Eventos</a>
        <a class="text-lg py-3 transition hover:text-indigo-200 hover:pl-2 duration-200 border-b border-indigo-800" href="/contactos">Contactos</a>
        <a class="mt-2 rounded-full bg-white/10 px-5 py-3 text-center text-lg ring-1 ring-white/25 transition hover:bg-white/20" href="/questionario">Junta-te</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
  const menuButton = document.getElementById('mobile-menu-button');
  const closeButton = document.getElementById('close-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  
  function openMenu() {
    if (mobileMenu && overlay) {
      // Enable pointer events and show overlay
      overlay.classList.remove('pointer-events-none', 'opacity-0');
      overlay.classList.add('pointer-events-auto', 'opacity-100');
      
      // Slide in menu
      mobileMenu.classList.remove('translate-x-full');
      
      // Update aria
      if (menuButton) {
        menuButton.setAttribute('aria-expanded', 'true');
      }
      
      // Animate hamburger to X
      if (menuButton) {
        const spans = menuButton.querySelectorAll('span');
        spans[0].style.transform = 'rotate(45deg) translateY(8px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translateY(-8px)';
      }
      
      // Prevent body scroll
      document.body.style.overflow = 'hidden';
    }
  }
  
  function closeMenu() {
    if (mobileMenu && overlay) {
      // Hide overlay and disable pointer events
      overlay.classList.remove('pointer-events-auto', 'opacity-100');
      overlay.classList.add('pointer-events-none', 'opacity-0');
      
      // Slide out menu
      mobileMenu.classList.add('translate-x-full');
      
      // Update aria
      if (menuButton) {
        menuButton.setAttribute('aria-expanded', 'false');
      }
      
      // Reset hamburger icon
      if (menuButton) {
        const spans = menuButton.querySelectorAll('span');
        spans[0].style.transform = 'none';
        spans[1].style.opacity = '1';
        spans[2].style.transform = 'none';
      }
      
      // Restore body scroll
      document.body.style.overflow = '';
    }
  }
  
  // Open menu
  if (menuButton) {
    menuButton.addEventListener('click', openMenu);
  }
  
  // Close menu via close button
  if (closeButton) {
    closeButton.addEventListener('click', closeMenu);
  }
  
  // Close menu via overlay click
  if (overlay) {
    overlay.addEventListener('click', closeMenu);
  }
</script>