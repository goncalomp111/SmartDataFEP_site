  <!-- ===================================================================== -->
  <!-- 4. SCRIPT CLIENT-SIDE (SUPABASE, DADOS & WORKFLOWS)                   -->
  <!-- ===================================================================== -->
  <script>
    import { supabase } from '../lib/supabase';

    let currentProfile: any = null;
    let smartKitItems: any[] = [];
    let myCompletedItemIds: string[] = [];
    let rhCandidatesList: any[] = [];

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', session.user.id)
        .maybeSingle();

      if (!profile) {
        window.location.href = '/portal';
        return;
      }

      currentProfile = profile;
      setupHeroAndProfile(profile);
      applyRBAC(profile);
      
      await fetchSmartKit(profile);
      await fetchFormacoes();
      await fetchProgress(profile);
      await fetchPRs(profile);

      if (profile.department === 'recursos-humanos' || ['diretor_executivo', 'smart_admin'].includes(profile.role)) {
        await fetchRHCandidates();
      }
      if (['diretor_dept', 'diretor_executivo', 'smart_admin'].includes(profile.role)) {
        await fetchDeptMembersForPR(profile);
        await fetchApprovals();
      }
    }

    function setupHeroAndProfile(p: any) {
      const initials = document.getElementById('user-avatar-initials');
      const dName = document.getElementById('user-display-name');
      const dUp = document.getElementById('user-display-up');
      const dDept = document.getElementById('user-display-dept');
      const dTier = document.getElementById('user-display-tier');

      if (initials) initials.innerText = p.nome.split(' ').map((n: string) => n[0]).slice(0, 2).join('');
      if (dName) dName.innerText = p.nome;
      if (dUp) dUp.innerText = `${p.up_number} (${p.email})`;
      if (dDept) dDept.innerText = p.department ? p.department.replace(/-/g, ' ') : 'Geral';
      if (dTier) dTier.innerText = `${p.role.replace('_', ' ')} • ${p.tier}`;

      const pName = document.getElementById('profile-static-name');
      const pUp = document.getElementById('profile-static-up');
      const pDept = document.getElementById('profile-static-dept');
      const pRole = document.getElementById('profile-static-role');

      if (pName) pName.innerText = p.nome;
      if (pUp) pUp.innerText = `${p.up_number} (${p.email})`;
      if (pDept) pDept.innerText = p.department ? p.department.replace(/-/g, ' ') : 'Geral';
      if (pRole) pRole.innerText = `${p.role.replace('_', ' ')} (${p.tier})`;

      const tel = document.getElementById('inputTelefone') as HTMLInputElement;
      const lk = document.getElementById('inputLinkedin') as HTMLInputElement;
      const bio = document.getElementById('inputBio') as HTMLTextAreaElement;
      if (tel && p.telefone) tel.value = p.telefone;
      if (lk && p.linkedin_url) lk.value = p.linkedin_url;
      if (bio && p.bio) bio.value = p.bio;
    }

    function applyRBAC(p: any) {
      if (p.department === 'educacao-formacao' || ['diretor_executivo', 'smart_admin'].includes(p.role)) {
        document.getElementById('nav-btn-ef')?.classList.remove('hidden');
      }
      if (p.department === 'recursos-humanos' || ['diretor_executivo', 'smart_admin'].includes(p.role)) {
        document.getElementById('nav-btn-rh')?.classList.remove('hidden');
      }
      if (['diretor_dept', 'diretor_executivo', 'smart_admin'].includes(p.role)) {
        document.getElementById('nav-btn-direcao')?.classList.remove('hidden');
      }
    }

    // --- SMARTKIT & PROGRESSO ---
    async function fetchSmartKit(p: any) {
      const { data } = await supabase
        .from('smartkit_items')
        .select('*')
        .or(`department.is.null,department.eq.${p.department}`)
        .order('ordem', { ascending: true });

      smartKitItems = data || [];
    }

    const hub = document.getElementById('smartkit-hub');
    const details = document.getElementById('smartkit-details');
    const itemsGrid = document.getElementById('smartkit-items-grid');
    const dTitle = document.getElementById('details-category-title');
    const dSubtitle = document.getElementById('details-category-subtitle');
    const dIndicator = document.getElementById('details-view-indicator');

    function openSmartKitSection(seccao: string, title: string, subtitle: string) {
      if (!hub || !details || !itemsGrid || !dTitle || !dSubtitle || !dIndicator) return;

      dTitle.innerText = title;
      dSubtitle.innerText = subtitle;
      dIndicator.innerText = title;
      hub.classList.add('hidden');
      details.classList.remove('hidden');

      const filtered = smartKitItems.filter(i => i.seccao === seccao);

      if (filtered.length === 0) {
        itemsGrid.innerHTML = `<p class="col-span-3 text-center text-xs text-gray-400 py-12">Não existem recursos disponíveis de momento.</p>`;
        return;
      }

      itemsGrid.innerHTML = filtered.map(item => `
        <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700">${item.seccao}</span>
            <h4 class="text-lg font-bold text-indigo-950 mt-1 mb-2">${item.titulo}</h4>
            <p class="text-xs text-gray-600 leading-relaxed font-light">${item.descricao || ''}</p>
          </div>
          <div class="pt-6 mt-4 border-t border-gray-100 flex items-center justify-between">
            <span class="text-[11px] font-medium text-gray-400">Recurso Oficial</span>
            <a href="${item.link_recurso}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#1e1b4b] hover:text-blue-700 transition-colors">
              Aceder ↗
            </a>
          </div>
        </article>
      `).join('');
    }

    document.getElementById('btn-open-fundamentos')?.addEventListener('click', () => openSmartKitSection('fundamentos', 'Aprende os Fundamentos Essenciais', 'Módulos e diretrizes recomendadas.'));
    document.getElementById('btn-open-formacoes')?.addEventListener('click', () => openSmartKitSection('formacoes', 'Gravações de Formações Internas', 'Workshops e formações passadas.'));
    document.getElementById('btn-open-ferramentas')?.addEventListener('click', () => openSmartKitSection('ferramentas', 'Ferramentas do Teu Departamento', 'Recursos operacionais dedicados.'));
    document.getElementById('btn-back-hub')?.addEventListener('click', () => { details?.classList.add('hidden'); hub?.classList.remove('hidden'); });

    // Progresso & Checklist
    async function fetchProgress(p: any) {
      const { data: progress } = await supabase.from('member_progress').select('smartkit_item_id').eq('membro_id', p.id);
      myCompletedItemIds = progress ? progress.map(item => item.smartkit_item_id).filter(Boolean) : [];

      const total = smartKitItems.length || 1;
      const count = myCompletedItemIds.length;
      const pct = Math.min(100, Math.round((count / total) * 100));

      const dCount = document.getElementById('stat-done-count');
      const pCount = document.getElementById('stat-pending-count');
      const pText = document.getElementById('stat-progress-pct');
      const bar = document.getElementById('progress-bar-element');

      if (dCount) dCount.innerText = count.toString();
      if (pCount) pCount.innerText = Math.max(0, total - count).toString();
      if (pText) pText.innerText = `${pct}%`;
      if (bar) bar.style.width = `${pct}%`;

      // Renderizar Checklist
      const checkCont = document.getElementById('checklist-modules');
      if (!checkCont) return;

      if (smartKitItems.length === 0) {
        checkCont.innerHTML = '<p class="text-xs text-gray-400 py-2">Sem módulos carregados.</p>';
        return;
      }

      checkCont.innerHTML = smartKitItems.map(item => {
        const isDone = myCompletedItemIds.includes(item.id);
        return `
          <div class="flex items-center justify-between py-3">
            <div class="flex items-center gap-3">
              <input type="checkbox" data-item-id="${item.id}" ${isDone ? 'checked' : ''} class="item-progress-chk h-4 w-4 rounded text-blue-600 cursor-pointer" />
              <div>
                <span class="text-xs font-bold text-indigo-950 block">${item.titulo}</span>
                <span class="text-[10px] text-gray-400 uppercase">${item.seccao}</span>
              </div>
            </div>
            <a href="${item.link_recurso}" target="_blank" class="text-xs text-blue-600 hover:underline font-semibold">Abrir ↗</a>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.item-progress-chk').forEach(chk => {
        chk.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const itemId = target.getAttribute('data-item-id');
          if (!itemId) return;

          if (target.checked) {
            await supabase.from('member_progress').insert([{ membro_id: p.id, smartkit_item_id: itemId, concluido: true }]);
          } else {
            await supabase.from('member_progress').delete().eq('membro_id', p.id).eq('smartkit_item_id', itemId);
          }
          await fetchProgress(p);
        });
      });
    }

    // --- FORMAÇÕES (CALENDÁRIO & ELIMINAÇÃO) ---
    async function fetchFormacoes() {
      const { data } = await supabase.from('formacoes').select('*').order('data_hora', { ascending: true });
      const container = document.getElementById('formacoes-container');
      const nextName = document.getElementById('next-event-name');
      const nextDet = document.getElementById('next-event-details');

      if (!data || data.length === 0) {
        if (container) container.innerHTML = `<p class="text-center text-xs text-gray-400 py-8">Não existem formações agendadas de momento.</p>`;
        if (nextName) nextName.innerText = 'Sem eventos futuros';
        return;
      }

      if (nextName) nextName.innerText = data[0].titulo;
      if (nextDet) nextDet.innerText = `${new Date(data[0].data_hora).toLocaleDateString('pt-PT', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })} • ${data[0].local_link}`;

      const isEF = currentProfile?.department === 'educacao-formacao' || ['diretor_executivo', 'smart_admin'].includes(currentProfile?.role);

      if (container) {
        container.innerHTML = data.map(f => `
          <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700">Formação Interna</span>
              <h4 class="text-base font-bold text-indigo-950 mt-0.5">${f.titulo}</h4>
              <p class="text-xs text-gray-500 mt-1">Formador: ${f.formador} • Local: ${f.local_link}</p>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-bold text-[#1e1b4b] bg-gray-100 px-4 py-2 rounded-full inline-block">
                ${new Date(f.data_hora).toLocaleDateString('pt-PT', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}
              </span>
              ${isEF ? `<button data-del-form="${f.id}" class="text-xs text-red-500 hover:text-red-700 font-bold px-2 py-1 rounded cursor-pointer" title="Eliminar Formação">✕</button>` : ''}
            </div>
          </div>
        `).join('');

        document.querySelectorAll('[data-del-form]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const fid = btn.getAttribute('data-del-form');
            if (confirm('Desejas eliminar esta formação do calendário?')) {
              await supabase.from('formacoes').delete().eq('id', fid);
              await fetchFormacoes();
            }
          });
        });
      }
    }

    // --- RECURSOS HUMANOS (RH) & MODAL ---
    async function fetchRHCandidates() {
      const { data } = await supabase.from('candidate_portal').select('*').order('submitted_at', { ascending: false });
      rhCandidatesList = data || [];
      const tbody = document.getElementById('rh-candidates-table');
      if (!tbody || !data) return;

      tbody.innerHTML = data.map(c => `
        <tr class="hover:bg-gray-50/80 transition-colors">
          <td class="py-3.5 px-4 font-bold text-indigo-950">${c.candidate_name} <br/><span class="text-[10px] text-gray-400 font-normal font-mono">${c.up_number}</span></td>
          <td class="py-3.5 px-4">${c.current_phase}</td>
          <td class="py-3.5 px-4 capitalize">${c.target_department ? c.target_department.replace(/-/g, ' ') : 'Geral'}</td>
          <td class="py-3.5 px-4"><span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${c.status_badge === 'accepted' ? 'bg-emerald-100 text-emerald-800' : c.status_badge === 'rejected' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800'}">${c.status}</span></td>
          <td class="py-3.5 px-4 text-right">
            <button data-manage-up="${c.up_number}" class="px-3 py-1.5 rounded-full bg-[#1e1b4b] text-white font-bold text-[11px] hover:bg-blue-700 transition-colors cursor-pointer">
              Gerir
            </button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll('[data-manage-up]').forEach(b => {
        b.addEventListener('click', () => {
          const up = b.getAttribute('data-manage-up');
          const candidate = rhCandidatesList.find(c => c.up_number === up);
          if (candidate) openCandidateModal(candidate);
        });
      });
    }

    function openCandidateModal(c: any) {
      const modal = document.getElementById('modalCandidate');
      if (!modal) return;

      (document.getElementById('modalCandidateName') as HTMLElement).innerText = c.candidate_name;
      (document.getElementById('modalCandidateUP') as HTMLElement).innerText = `${c.up_number} • ${c.email}`;
      (document.getElementById('modalTargetUP') as HTMLInputElement).value = c.up_number;
      (document.getElementById('modalCurrentPhase') as HTMLSelectElement).value = c.current_phase;
      (document.getElementById('modalStatusBadge') as HTMLSelectElement).value = c.status_badge;
      (document.getElementById('modalTargetDept') as HTMLSelectElement).value = c.target_department || '';
      (document.getElementById('modalPersonalizedMsg') as HTMLTextAreaElement).value = c.personalized_message || '';
      (document.getElementById('modalReachedInterview') as HTMLInputElement).checked = !!c.reached_interview;

      const report = c.performance_report || {};
      (document.getElementById('modalFeedbackSummary') as HTMLInputElement).value = report.summary || '';
      (document.getElementById('modalFeedbackStrengths') as HTMLInputElement).value = report.strengths || '';
      (document.getElementById('modalFeedbackNotes') as HTMLInputElement).value = report.feedback_notes || '';

      modal.classList.remove('hidden');
    }

    document.getElementById('btnCloseModal')?.addEventListener('click', () => {
      document.getElementById('modalCandidate')?.classList.add('hidden');
    });

    document.getElementById('candidateManageForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const up = (document.getElementById('modalTargetUP') as HTMLInputElement).value;
      const phase = (document.getElementById('modalCurrentPhase') as HTMLSelectElement).value;
      const badge = (document.getElementById('modalStatusBadge') as HTMLSelectElement).value;
      const dept = (document.getElementById('modalTargetDept') as HTMLSelectElement).value || null;
      const msg = (document.getElementById('modalPersonalizedMsg') as HTMLTextAreaElement).value;
      const reached = (document.getElementById('modalReachedInterview') as HTMLInputElement).checked;

      const statusMap: Record<string, string> = {
        'pending': 'Em Análise',
        'active': 'Convocado',
        'accepted': 'Aprovado',
        'rejected': 'Não Selecionado'
      };

      const summary = (document.getElementById('modalFeedbackSummary') as HTMLInputElement).value;
      const strengths = (document.getElementById('modalFeedbackStrengths') as HTMLInputElement).value;
      const notes = (document.getElementById('modalFeedbackNotes') as HTMLInputElement).value;

      let perfReport = null;
      if (reached && (summary || strengths || notes)) {
        perfReport = { summary, strengths, feedback_notes: notes };
      }

      await supabase.from('candidate_portal').update({
        current_phase: phase,
        status_badge: badge,
        status: statusMap[badge] || 'Em Análise',
        target_department: dept,
        personalized_message: msg,
        reached_interview: reached,
        performance_report: perfReport,
        last_updated: new Date().toISOString()
      }).eq('up_number', up);

      alert('Dados do candidato atualizados com sucesso!');
      document.getElementById('modalCandidate')?.classList.add('hidden');
      await fetchRHCandidates();
    });

    // --- PERSONAL REVIEWS (PR) ---
    async function fetchPRs(p: any) {
      const { data } = await supabase.from('personal_reviews').select('*').eq('membro_id', p.id).order('mes_ano', { ascending: false });
      const container = document.getElementById('prs-container');
      if (!container) return;

      if (!data || data.length === 0) {
        container.innerHTML = `<p class="text-center text-xs text-gray-400 py-8">Ainda não tens avaliações de PR registadas.</p>`;
        return;
      }

      container.innerHTML = data.map(pr => `
        <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700">Edição ${new Date(pr.mes_ano).toLocaleDateString('pt-PT', { month: 'long', year: 'numeric' })}</span>
            <span class="text-xs font-bold text-white bg-[#1e1b4b] px-3 py-1 rounded-full">Nota: ${pr.nota_geral} / 5</span>
          </div>
          <div class="space-y-2 text-xs">
            <div>
              <span class="font-bold text-indigo-950 block">Pontos Fortes:</span>
              <p class="text-gray-600 mt-0.5 leading-relaxed">${pr.pontos_fortes}</p>
            </div>
            <div>
              <span class="font-bold text-indigo-950 block">Pontos de Melhoria:</span>
              <p class="text-gray-600 mt-0.5 leading-relaxed">${pr.pontos_melhoria}</p>
            </div>
          </div>
        </article>
      `).join('');
    }

    async function fetchDeptMembersForPR(p: any) {
      const { data } = await supabase.from('profiles').select('id, nome, up_number, department');
      const selectPR = document.getElementById('selectMemberPR') as HTMLSelectElement;
      const selectTransfer = document.getElementById('selectTransferMember') as HTMLSelectElement;
      if (!data) return;

      const filteredPR = p.role === 'diretor_dept' ? data.filter(m => m.department === p.department && m.id !== p.id) : data.filter(m => m.id !== p.id);

      if (selectPR) {
        selectPR.innerHTML = '<option value="">Seleciona um membro...</option>' + 
          filteredPR.map(m => `<option value="${m.id}">${m.nome} (${m.up_number})</option>`).join('');
      }

      if (selectTransfer) {
        selectTransfer.innerHTML = '<option value="">Seleciona um membro...</option>' + 
          data.map(m => `<option value="${m.id}">${m.nome} (${m.department || 'Geral'})</option>`).join('');
      }
    }

    // --- GOVERNAÇÃO & FILA DE APROVAÇÕES ---
    async function fetchApprovals() {
      const { data } = await supabase.from('system_approvals').select('*, profiles:target_user_id(nome, up_number)').eq('status', 'pendente');
      const cont = document.getElementById('approvals-container');
      if (!cont) return;

      if (!data || data.length === 0) {
        cont.innerHTML = '<p class="text-xs text-gray-400 py-4 italic">Não existem pedidos de autorização pendentes.</p>';
        return;
      }

      const isExecutive = ['diretor_executivo', 'smart_admin'].includes(currentProfile?.role);

      cont.innerHTML = data.map(app => `
        <div class="flex items-center justify-between py-3">
          <div>
            <span class="text-xs font-bold text-indigo-950 block">${app.tipo.replace('_', ' ').toUpperCase()} — ${app.profiles?.nome}</span>
            <span class="text-[10px] text-gray-400 block">${app.motivo || 'Sem justificação'}</span>
          </div>
          ${isExecutive ? `
            <div class="flex items-center gap-2">
              <button data-approve="${app.id}" class="px-3 py-1 rounded bg-emerald-600 text-white font-bold text-[10px] hover:bg-emerald-700 cursor-pointer">Aprovar</button>
              <button data-reject="${app.id}" class="px-3 py-1 rounded bg-red-600 text-white font-bold text-[10px] hover:bg-red-700 cursor-pointer">Rejeitar</button>
            </div>
          ` : '<span class="text-[10px] text-yellow-600 font-bold bg-yellow-50 px-2 py-0.5 rounded">A aguardar Direção Executiva</span>'}
        </div>
      `).join('');

      document.querySelectorAll('[data-approve]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-approve');
          await resolveApproval(id!, 'aprovado');
        });
      });

      document.querySelectorAll('[data-reject]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-reject');
          await resolveApproval(id!, 'rejeitado');
        });
      });
    }

    async function resolveApproval(id: string, status: string) {
      const { data: approval } = await supabase.from('system_approvals').select('*').eq('id', id).single();
      if (!approval) return;

      if (status === 'aprovado') {
        if (approval.tipo === 'eliminar_membro' || approval.tipo === 'eliminar_diretor') {
          await supabase.from('profiles').update({ is_active: false }).eq('id', approval.target_user_id);
        } else if (approval.tipo === 'alterar_diretor') {
          await supabase.from('profiles').update({
            role: approval.novo_role || 'membro',
            department: approval.novo_department
          }).eq('id', approval.target_user_id);
        }
      }

      await supabase.from('system_approvals').update({
        status: status,
        aprovador_id: currentProfile.id,
        aprovado_em: new Date().toISOString()
      }).eq('id', id);

      alert(`Pedido ${status} com sucesso!`);
      await fetchApprovals();
    }

    // --- FORMULÁRIOS RESTANTES ---
    document.getElementById('createFormacaoForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const titulo = (document.getElementById('inputFormacaoTitulo') as HTMLInputElement).value;
      const formador = (document.getElementById('inputFormacaoFormador') as HTMLInputElement).value;
      const dataHora = (document.getElementById('inputFormacaoData') as HTMLInputElement).value;
      const local = (document.getElementById('inputFormacaoLocal') as HTMLInputElement).value;
      const desc = (document.getElementById('inputFormacaoDesc') as HTMLTextAreaElement).value;

      await supabase.from('formacoes').insert([{
        titulo, formador, data_hora: dataHora, local_link: local, descricao: desc, created_by: currentProfile.id
      }]);

      alert('Formação publicada com sucesso!');
      (e.target as HTMLFormElement).reset();
      await fetchFormacoes();
    });

    document.getElementById('createSmartkitItemForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const secao = (document.getElementById('inputKitSecao') as HTMLSelectElement).value;
      const titulo = (document.getElementById('inputKitTitulo') as HTMLInputElement).value;
      const link = (document.getElementById('inputKitLink') as HTMLInputElement).value;
      const dept = (document.getElementById('inputKitDept') as HTMLSelectElement).value || null;

      await supabase.from('smartkit_items').insert([{
        seccao: secao, titulo, link_recurso: link, department: dept
      }]);

      alert('Recurso publicado no SmartKit com sucesso!');
      (e.target as HTMLFormElement).reset();
      await fetchSmartKit(currentProfile);
    });

    document.getElementById('submitPRForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const membroId = (document.getElementById('selectMemberPR') as HTMLSelectElement).value;
      const nota = parseInt((document.getElementById('inputNotaPR') as HTMLInputElement).value);
      const fortes = (document.getElementById('inputFortesPR') as HTMLTextAreaElement).value;
      const melhoria = (document.getElementById('inputMelhoriaPR') as HTMLTextAreaElement).value;

      await supabase.from('personal_reviews').insert([{
        membro_id: membroId,
        avaliador_id: currentProfile.id,
        mes_ano: new Date().toISOString().slice(0, 10),
        nota_geral: nota,
        pontos_fortes: fortes,
        pontos_melhoria: melhoria
      }]);

      alert('Personal Review gravado com sucesso!');
      (e.target as HTMLFormElement).reset();
    });

    document.getElementById('transferDeptForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetId = (document.getElementById('selectTransferMember') as HTMLSelectElement).value;
      const newDept = (document.getElementById('selectNewDept') as HTMLSelectElement).value;

      await supabase.from('profiles').update({ department: newDept }).eq('id', targetId);
      alert('Transferência executada com sucesso!');
      await fetchDeptMembersForPR(currentProfile);
    });

    document.getElementById('profileEditForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentProfile) return;

      const tel = (document.getElementById('inputTelefone') as HTMLInputElement).value;
      const lk = (document.getElementById('inputLinkedin') as HTMLInputElement).value;
      const bio = (document.getElementById('inputBio') as HTMLTextAreaElement).value;

      await supabase.from('profiles').update({ telefone: tel, linkedin_url: lk, bio: bio }).eq('id', currentProfile.id);
      alert('Contactos guardados com sucesso!');
    });

    // Abas
    const navBtns = document.querySelectorAll('.nav-tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.tab;
        if (!target) return;

        navBtns.forEach(b => {
          b.classList.remove('active', 'text-white', 'after:absolute', 'after:bottom-0', 'after:left-0', 'after:h-0.5', 'after:w-full', 'after:bg-blue-400');
          b.classList.add('text-gray-400');
        });

        btn.classList.add('active', 'text-white', 'after:absolute', 'after:bottom-0', 'after:left-0', 'after:h-0.5', 'after:w-full', 'after:bg-blue-400');
        btn.classList.remove('text-gray-400');

        tabPanes.forEach(p => p.classList.add('hidden'));
        document.getElementById(`tab-${target}`)?.classList.remove('hidden');
      });
    });

    document.getElementById('btnLogout')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/login';
    });

    init();
  </script>
</Layout>
