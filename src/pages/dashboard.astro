---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard de Membros — SmartData FEP">
  
  <!-- ===================================================================== -->
  <!-- 1. HERO INSTITUCIONAL SMARTDATA                                       -->
  <!-- ===================================================================== -->
  <section class="relative overflow-hidden bg-[#1e1b4b] px-4 pt-12 pb-16 text-white md:px-6 md:pt-24 md:pb-20">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-[url('/src/assets/home/images/smart_backgroud.png')] bg-cover bg-center opacity-100 mix-blend-overlay"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#1e1b4b] via-[#1e1b4b]/90 to-transparent"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-screen-xl px-4 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-end">
        
        <!-- Lado Esquerdo (3 Colunas) -->
        <div class="space-y-6 md:col-span-3">
          <div class="inline-block border-l-4 border-blue-400 pl-4">
            <span class="text-xs font-semibold uppercase tracking-widest text-blue-200 md:text-sm">
              Portal Interno
            </span>
          </div>

          <h1 class="text-3xl md:text-5xl font-medium leading-tight max-w-4xl">
            Welcome to the <br/>
            <span class="bg-gradient-to-r from-blue-200 to-indigo-400 bg-clip-text text-transparent">Smart Workspace</span>.
          </h1>

          <p class="text-base md:text-xl text-gray-300 font-light leading-relaxed max-w-2xl">
            Acompanha o teu progresso, explora o SmartKit e colabora com a equipa na governação e atividades da organização.
          </p>

          <!-- Abas com Underline Ativo -->
          <div class="pt-4 flex flex-wrap items-center gap-6 border-b border-white/10 pb-1 text-sm font-semibold">
            <button class="nav-tab-btn active relative pb-3 text-white transition-all after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-blue-400 cursor-pointer" data-tab="smartkit">
              SmartKit
            </button>
            <button class="nav-tab-btn relative pb-3 text-gray-400 hover:text-white transition-all cursor-pointer" data-tab="percurso">
              O Meu Percurso
            </button>
            <button class="nav-tab-btn relative pb-3 text-gray-400 hover:text-white transition-all cursor-pointer" data-tab="calendario">
              Calendário
            </button>
            <button class="nav-tab-btn relative pb-3 text-gray-400 hover:text-white transition-all cursor-pointer" data-tab="meu-pr">
              O Meu PR
            </button>
            
            <!-- Abas Dinâmicas de Gestão -->
            <button id="nav-btn-ef" class="nav-tab-btn hidden relative pb-3 text-blue-300 hover:text-white transition-all cursor-pointer" data-tab="gestao-ef">
              Gestão EF
            </button>
            <button id="nav-btn-rh" class="nav-tab-btn hidden relative pb-3 text-indigo-300 hover:text-white transition-all cursor-pointer" data-tab="gestao-rh">
              Recrutamento RH
            </button>
            <button id="nav-btn-direcao" class="nav-tab-btn hidden relative pb-3 text-purple-300 hover:text-white transition-all cursor-pointer" data-tab="painel-lideranca">
              Liderança & Governação
            </button>
          </div>
        </div>

        <!-- Lado Direito: Perfil Institucional (2 Colunas) -->
        <div class="md:col-span-2">
          <div class="w-full rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <div class="flex items-center gap-3">
                <div class="h-12 w-12 rounded-full border-2 border-white/30 bg-[#1e1b4b] flex items-center justify-center font-bold text-sm text-blue-200" id="user-avatar-initials">
                  SD
                </div>
                <div>
                  <h3 class="text-base font-bold text-white leading-tight" id="user-display-name">A carregar...</h3>
                  <span class="text-xs text-blue-200 font-mono" id="user-display-up">up2026xxxxx</span>
                </div>
              </div>
              <button id="btnLogout" class="p-2 rounded-xl text-gray-400 hover:text-red-300 hover:bg-red-500/10 transition-colors" title="Terminar Sessão">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-4 text-xs pt-1">
              <div>
                <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Departamento</span>
                <span class="font-semibold text-blue-200 capitalize mt-0.5 block truncate" id="user-display-dept">--</span>
              </div>
              <div>
                <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Cargo & Nível</span>
                <span class="font-semibold text-white capitalize mt-0.5 block truncate" id="user-display-tier">--</span>
              </div>
            </div>

            <div class="pt-2">
              <button data-tab="perfil" class="nav-tab-btn w-full py-2.5 rounded-full border border-white/20 bg-white/10 hover:bg-white hover:text-[#1e1b4b] text-xs font-bold text-white transition-all text-center cursor-pointer">
                Ver e Editar Perfil
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. CORPO PRINCIPAL COM CONTEÚDOS DAS ABAS                             -->
  <!-- ===================================================================== -->
  <section class="bg-gray-50 py-12 md:py-20 min-h-[500px]">
    <div class="mx-auto max-w-screen-xl px-4 md:px-10">

      <!-- ================================================================= -->
      <!-- ABA 1: SMARTKIT                                                   -->
      <!-- ================================================================= -->
      <div id="tab-smartkit" class="tab-pane space-y-12">
        
        <!-- HUB INICIAL -->
        <div id="smartkit-hub" class="space-y-8">
          <div class="text-center max-w-2xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">SmartKit</h2>
            <p class="text-gray-600 mt-2 text-sm md:text-base">
              A plataforma interna de capacitação técnica, boas práticas e ferramentas departamentais da SmartData FEP.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
              <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div>
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
                  01
                </div>
                <h3 class="mb-3 text-2xl font-bold text-indigo-950">Aprende os fundamentos essenciais</h3>
                <p class="text-sm leading-relaxed text-gray-600">
                  Conteúdos e boas práticas recomendadas a todos os membros da SmartData.
                </p>
              </div>
              <button id="btn-open-fundamentos" class="mt-8 group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-[#1e1b4b] px-6 py-3 font-bold text-white transition-all hover:bg-[#1e1b4b]/90 text-xs cursor-pointer">
                <span>Explorar Fundamentos</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </button>
            </article>

            <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
              <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div>
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
                  02
                </div>
                <h3 class="mb-3 text-2xl font-bold text-indigo-950">Revê as formações gravadas</h3>
                <p class="text-sm leading-relaxed text-gray-600">
                  Gravações e materiais das formações internas dinamizadas por EF.
                </p>
              </div>
              <button id="btn-open-formacoes" class="mt-8 group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-[#1e1b4b] px-6 py-3 font-bold text-white transition-all hover:bg-[#1e1b4b]/90 text-xs cursor-pointer">
                <span>Explorar Formações</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </button>
            </article>

            <article class="group relative flex h-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
              <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div>
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
                  03
                </div>
                <h3 class="mb-3 text-2xl font-bold text-indigo-950">Explora ferramentas departamentais</h3>
                <p class="text-sm leading-relaxed text-gray-600">
                  Instrumentos e templates dedicados às atividades do teu departamento.
                </p>
              </div>
              <button id="btn-open-ferramentas" class="mt-8 group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-[#1e1b4b] px-6 py-3 font-bold text-white transition-all hover:bg-[#1e1b4b]/90 text-xs cursor-pointer">
                <span>Explorar Ferramentas</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </button>
            </article>
          </div>
        </div>

        <!-- SUB-ECRÃ DETALHADO DO SMARTKIT -->
        <div id="smartkit-details" class="hidden space-y-8">
          <div class="flex items-center justify-between border-b border-gray-200 pb-4">
            <button id="btn-back-hub" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1e1b4b] hover:text-blue-700 transition-colors cursor-pointer">
              ← Voltar ao SmartKit Hub
            </button>
            <span class="text-xs text-gray-500 font-medium" id="details-view-indicator">Secção Ativa</span>
          </div>

          <div class="text-center max-w-2xl mx-auto mb-8">
            <h3 class="text-2xl md:text-3xl font-bold text-[#1e1b4b]" id="details-category-title">--</h3>
            <p class="text-gray-600 text-sm mt-1" id="details-category-subtitle">--</p>
          </div>

          <div id="smartkit-items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </div>

      </div>

      <!-- ================================================================= -->
      <!-- ABA 2: O MEU PERCURSO & PROGRESSO INTERATIVO                      -->
      <!-- ================================================================= -->
      <div id="tab-percurso" class="tab-pane hidden space-y-12">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">O Meu Percurso</h2>
          <p class="text-gray-600 mt-2 text-sm md:text-base">
            Métricas de formação e checklist interativa de conclusão de competências.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="md:col-span-2 rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-blue-700">Plano Formativo</span>
                <h3 class="text-xl font-bold text-indigo-950 mt-1">Conclusão de Módulos</h3>
              </div>
              <span class="text-3xl font-bold text-[#1e1b4b]" id="stat-progress-pct">0%</span>
            </div>

            <div class="w-full h-3 rounded-full bg-gray-100 overflow-hidden">
              <div id="progress-bar-element" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-700" style="width: 0%;"></div>
            </div>

            <div class="grid grid-cols-3 gap-4 pt-4 border-t border-gray-100 text-center">
              <div>
                <span class="block text-2xl font-bold text-[#1e1b4b]" id="stat-done-count">0</span>
                <span class="text-xs text-gray-500 font-medium">Completados</span>
              </div>
              <div>
                <span class="block text-2xl font-bold text-gray-400" id="stat-pending-count">0</span>
                <span class="text-xs text-gray-500 font-medium">Por Concluir</span>
              </div>
              <div>
                <span class="block text-2xl font-bold text-emerald-600">Ativo</span>
                <span class="text-xs text-gray-500 font-medium">Estatuto</span>
              </div>
            </div>
          </div>

          <!-- Próximo Encontro -->
          <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold uppercase tracking-widest text-blue-700">Próxima Formação</span>
              <h3 class="text-lg font-bold text-indigo-950 mt-2" id="next-event-name">A carregar sessões...</h3>
              <p class="text-xs text-gray-500 mt-2 leading-relaxed" id="next-event-details">Consulta a data e liga-te à sessão em direto.</p>
            </div>
            <button data-tab="calendario" class="nav-tab-btn mt-6 w-full py-3 rounded-full border border-[#1e1b4b] text-[#1e1b4b] hover:bg-[#1e1b4b] hover:text-white text-xs font-bold transition-all text-center cursor-pointer">
              Ver Calendário
            </button>
          </div>
        </div>

        <!-- Checklist de Módulos para o Membro Concluir -->
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm space-y-4">
          <h3 class="text-base font-bold text-indigo-950">Checklist de Aprendizagem (SmartKit)</h3>
          <p class="text-xs text-gray-500">Marca os módulos do SmartKit que já exploraste e concluíste.</p>
          <div id="checklist-modules" class="divide-y divide-gray-100 space-y-2"></div>
        </div>
      </div>

      <!-- ================================================================= -->
      <!-- ABA 3: CALENDÁRIO DE FORMAÇÕES                                    -->
      <!-- ================================================================= -->
      <div id="tab-calendario" class="tab-pane hidden space-y-8">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">Calendário de Formações</h2>
          <p class="text-gray-600 mt-2 text-sm md:text-base">
            Workshops e sessões práticas agendadas pelo departamento de Educação & Formação (EF).
          </p>
        </div>

        <div id="formacoes-container" class="max-w-4xl mx-auto space-y-4"></div>
      </div>

      <!-- ================================================================= -->
      <!-- ABA 4: O MEU PR (PERSONAL REVIEW)                                 -->
      <!-- ================================================================= -->
      <div id="tab-meu-pr" class="tab-pane hidden space-y-8">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">O Meu Personal Review</h2>
          <p class="text-gray-600 mt-2 text-sm md:text-base">
            Acompanha o teu feedback mensal e metas acordadas com a tua Direção.
          </p>
        </div>

        <div id="prs-container" class="max-w-3xl mx-auto space-y-6"></div>
      </div>

      <!-- ================================================================= -->
      <!-- ABA 5: GESTÃO OPERACIONAL EF (FORMAÇÕES & SMARTKIT)               -->
      <!-- ================================================================= -->
      <div id="tab-gestao-ef" class="tab-pane hidden space-y-8">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">Gestão de Educação & Formação</h2>
          <p class="text-gray-600 mt-2 text-sm md:text-base">
            Agendamento de formações no calendário e gestão de novos recursos no SmartKit.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          
          <!-- Formulário Formações -->
          <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)]">
            <form id="createFormacaoForm" class="space-y-4 text-xs">
              <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-950 mb-2">Publicar Nova Formação</h3>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Título da Formação</label>
                <input type="text" id="inputFormacaoTitulo" required placeholder="Ex: Workshop Avançado de SQL & DAX" class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Formador</label>
                  <input type="text" id="inputFormacaoFormador" required placeholder="Ex: Maria Santos" class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
                </div>
                <div>
                  <label class="block font-semibold text-gray-700 mb-1">Data & Hora</label>
                  <input type="datetime-local" id="inputFormacaoData" required class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
                </div>
              </div>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Local / Link Teams</label>
                <input type="text" id="inputFormacaoLocal" required placeholder="Ex: Sala 120 FEP ou Link Teams" class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
              </div>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Descrição</label>
                <textarea id="inputFormacaoDesc" rows="2" placeholder="Tópicos abordados..." class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]"></textarea>
              </div>
              <button type="submit" class="w-full py-3.5 rounded-full bg-[#1e1b4b] text-white font-bold text-xs hover:bg-[#1e1b4b]/90 transition-all cursor-pointer">
                Publicar no Calendário
              </button>
            </form>
          </div>

          <!-- Formulário SmartKit Item -->
          <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)]">
            <form id="createSmartkitItemForm" class="space-y-4 text-xs">
              <h3 class="text-sm font-bold uppercase tracking-wider text-blue-700 mb-2">Adicionar Recurso ao SmartKit</h3>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Secção de Destino</label>
                <select id="inputKitSecao" required class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]">
                  <option value="fundamentos">1. Fundamentos Essenciais</option>
                  <option value="formacoes">2. Gravações & Materiais</option>
                  <option value="ferramentas">3. Ferramentas Departamentais</option>
                </select>
              </div>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Título do Recurso</label>
                <input type="text" id="inputKitTitulo" required placeholder="Ex: Gravação Workshop Machine Learning" class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
              </div>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Link de Acesso (URL)</label>
                <input type="url" id="inputKitLink" required placeholder="https://youtube.com/... ou https://notion.so/..." class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]" />
              </div>
              <div>
                <label class="block font-semibold text-gray-700 mb-1">Departamento (Opcional se for ferramenta)</label>
                <select id="inputKitDept" class="w-full rounded-xl border border-gray-300 px-4 py-2.5 bg-white text-gray-900 focus:outline-none focus:border-[#1e1b4b]">
                  <option value="">Geral / Aberto a Todos</option>
                  <option value="projetos-analise-dados">Projetos & Análise de Dados</option>
                  <option value="recursos-humanos">Recursos Humanos</option>
                  <option value="marketing">Marketing</option>
                  <option value="financeiro">Financeiro</option>
                  <option value="educacao-formacao">Educação & Formação</option>
                  <option value="relacoes-externas">Relações Externas</option>
                </select>
              </div>
              <button type="submit" class="w-full py-3.5 rounded-full bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition-all cursor-pointer">
                Disponibilizar no SmartKit
              </button>
            </form>
          </div>

        </div>
      </div>

      <!-- ================================================================= -->
      <!-- ABA 6: GESTÃO OPERACIONAL RH (TABELA + MODAL DE EDIÇÃO)           -->
      <!-- ================================================================= -->
      <div id="tab-gestao-rh" class="tab-pane hidden space-y-8">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-[#1e1b4b]">Gestão de Recrutamento</h2>
          <p class="text-gray-600 mt-2 text-sm md:text-base">
            Atualização em tempo real das fases, convocatórias e feedbacks dos candidatos.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] overflow-x-auto">
          <table class="w-full text-left text-xs text-gray-600">
            <thead class="border-b border-gray-100 text-[10px] font-bold uppercase tracking-wider text-gray-400">
              <tr>
                <th class="py-3 px-4">Candidato</th>
                <th class="py-3 px-4">Fase Atual</th>
                <th class="py-3 px-4">Departamento</th>
                <th class="py-3 px-4">Estado</th>
                <th class="py-3 px-4 text-right">Ação</th>
              </tr>
            </thead>
            <tbody id="rh-candidates-table" class="divide-y divide-gray-100"></tbody>
          </table>
        </div>
      </div>

      <!-- ================================================================= -->
