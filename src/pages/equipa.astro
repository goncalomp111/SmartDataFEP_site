/* Hide scrollbar arrows/buttons */
#RH-carousel::-webkit-scrollbar-button, #financeiro-carousel::-webkit-scrollbar-button,
#Educação-carousel::-webkit-scrollbar-button, #PAD-carousel::-webkit-scrollbar-button, #Mark-carousel::-webkit-scrollbar-button{
    display: none;
}

/* Scrollbar track */
#RH-carousel::-webkit-scrollbar-track, #financeiro-carousel::-webkit-scrollbar-track,
#Educação-carousel::-webkit-scrollbar-track, #PAD-carousel::-webkit-scrollbar-track, #Mark-carousel::-webkit-scrollbar-track{
    background: transparent;
}

#RH-carousel::-webkit-scrollbar-thumb, #financeiro-carousel::-webkit-scrollbar-thumb,
#Educação-carousel::-webkit-scrollbar-thumb, #PAD-carousel::-webkit-scrollbar-thumb, #Mark-carousel::-webkit-scrollbar-thumb{
    background: rgba(23, 24, 75, 0.4);
    border-radius: 10px;
    transition: background 0.3s ease;
}

#RH-carousel::-webkit-scrollbar-thumb:hover, #financeiro-carousel::-webkit-scrollbar-thumb:hover,
#Educação-carousel::-webkit-scrollbar-thumb:hover, #PAD-carousel::-webkit-scrollbar-thumb:hover, #Mark-carousel::-webkit-scrollbar-thumb:hover{
    background: rgba(23, 24, 75, 0.7);
}

#RH-carousel::-webkit-scrollbar-thumb:active, #financeiro-carousel::-webkit-scrollbar-thumb:active, 
#Educação-carousel::-webkit-scrollbar-thumb:active, #PAD-carousel::-webkit-scrollbar-thumb:active, #Mark-carousel::-webkit-scrollbar-thumb:active{
    background: #17184B;
}
</style>

<script>
    // Smooth scroll elevator effect with custom easing
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const scrollTo = urlParams.get('scrollTo');
        
        const validSections = ['recursos-humanos', 'financeiro', 'educacao-formacao', 'projetos-analise-dados', 'marketing', 'relacoes-externas'];
        
        if (scrollTo && validSections.includes(scrollTo)) {
            // Start at top - use direct property assignment for better Chrome compatibility
            document.documentElement.scrollTop = 0;
            document.body.scrollTop = 0;
            
            // Remove query parameter from URL
            const newUrl = window.location.pathname;
            history.replaceState(null, '', newUrl);
            
            // Wait, then smooth scroll to section with custom easing
            setTimeout(() => {
                const section = document.getElementById(scrollTo);
                if (section) {
                    const targetPosition = section.offsetTop;
                    const startPosition = 0;
                    const distance = targetPosition;
                    const duration = 2000; // 2 seconds for smooth elevator effect
                    let startTime: number | null = null;
                    
                    // Easing function: ease-in-out cubic for smooth acceleration and deceleration
                    const easeInOutCubic = (t: number): number => {
                        return t < 0.5 ? 4 * t * t * t : (t - 1) * (2 * t - 2) * (2 * t - 2) + 1;
                    };
                    
                    const animation = (currentTime: number): void => {
                        if (startTime === null) startTime = currentTime;
                        const timeElapsed = currentTime - startTime;
                        const progress = Math.min(timeElapsed / duration, 1);
                        const ease = easeInOutCubic(progress);
                        
                        const currentPosition = startPosition + distance * ease;
                        document.documentElement.scrollTop = currentPosition;
                        document.body.scrollTop = currentPosition;
                        
                        if (progress < 1) {
                            requestAnimationFrame(animation);
                        }
                    };
                    
                    requestAnimationFrame(animation);
                }
            }, 50);
        }
    });
</script>

