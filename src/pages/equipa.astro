---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Direção Geral
import leonorSantos from '../assets/equipa/images/Leonor Santos.jpg';
import mariaFontainhas from '../assets/equipa/images/Maria Fontainhas.jpg';

// Recursos Humanos
import leonorAlmeida from '../assets/equipa/images/Leonor Almeida.jpg';
import martaMartins from '../assets/equipa/images/Marta Martins.jpg';
import tomasGomes from '../assets/equipa/images/Tomás Gomes.jpg';
//Beatriz Ventura

// Financeiro
import pedroCarneiro from '../assets/equipa/images/Pedro Carneiro.jpg';
import catarinaMagalhaes from '../assets/equipa/images/Catarina Magalhães.jpg';
//Igor

// Educação e Formação
import filipaJose from '../assets/equipa/images/Filipa José.jpg';
//Cátia Ribeiro
//Filipa Canto

// Projetos e Análise de Dados
import franciscoRibeiro from '../assets/equipa/images/Francisco Ribeiro.jpg';
import goncaloPereira from '../assets/equipa/images/Gonçalo Pereira.jpg';
import sofiaLourosa from '../assets/equipa/images/Sofia Lourosa.jpg'
//Pedro Vilaça

// Marketing
import beatrizCosta from '../assets/equipa/images/Beatriz Costa.jpg';
import duarteAlpoim from '../assets/equipa/images/Duarte Alpoim.jpg';
import lauraBastos from '../assets/equipa/images/Laura Bastos.jpg';
import sofiaTumanova from '../assets/equipa/images/Sofia Tumanova.jpg';
//Rafael Mendes

// Relações Externas
import mariaMendes from '../assets/equipa/images/Maria Mendes.jpg';
import margaridaDamas from '../assets/equipa/images/Margarida Damas.jpg';
---

<Layout title="Equipa - SmartData FEP">

    <section class="relative bg-[#1e1b4b] text-white pt-12 pb-12 md:pt-28 md:pb-32 px-4 md:px-6 overflow-hidden" id="team-hero">
        <div class="absolute inset-0 z-0">
             <div class="absolute inset-0 bg-[url('/src/assets/home/images/smart_backgroud.png')] opacity-100 bg-cover bg-center mix-blend-overlay"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#1e1b4b] via-[#1e1b4b]/90 to-transparent"></div>
        </div>
        
        <div class="relative z-10 mx-auto max-w-screen-xl px-4 md:px-10">
            <div class="inline-block border-l-4 border-blue-400 pl-4 mb-6 md:mb-8">
                <span class="text-blue-200 uppercase tracking-widest text-xs md:text-sm font-semibold">Equipa</span>
            </div>
            
            <h1 class="text-3xl md:text-6xl lg:text-6xl font-medium leading-tight max-w-5xl">
                The team shaping <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-indigo-400">the future</span>.
            </h1>
            
            <p class="mt-6 md:mt-8 text-lg md:text-2xl text-gray-300 font-light max-w-3xl leading-relaxed">
                Conhece a equipa que todos os dias trabalha para aproximar o meio académico do mundo empresarial. Dedicada a Criar impacto, Desenvolver competências e Liderar a próxima geração em AI & BI na U.Porto.            
            </p>
        </div>
    </section>

	<section class="w-full bg-white py-12 md:py-24">
		<div class="mx-auto max-w-screen-xl px-4 md:px-0">
			<div class="text-center">
				<h3 class="text-3xl md:text-5xl font-bold text-indigo-950 mb-8 md:mb-6">Direção Geral</h3>
				<div class="flex flex-col md:flex-row items-center justify-center gap-10 md:gap-14">

					<div class="flex flex-col items-center">
						<div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center">
							<Image src={leonorSantos} alt="Diretor 1" class="object-cover object-center w-full h-full transform scale-120" />
						</div>
						<p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Leonor Santos</p>
						<p class="text-sm md:text-base text-gray-600 italic">Diretora-Geral Externa</p>
					</div>

					<div class="flex flex-col items-center">
						<div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center">
							<Image src={mariaFontainhas} alt="Diretor 2" class="object-cover object-center w-full h-full transform scale-120" />
						</div>
						<p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Maria Fontainhas</p>
						<p class="text-sm md:text-base text-gray-600 italic">Diretora-Geral Interna</p>
					</div>

				</div>
			</div>
		</div>
	</section>

    <section id="recursos-humanos" class="w-full bg-white py-16 md:py-26">
    <div class="mx-auto max-w-screen-xl px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-16 md:mb-24">
            <div>
                <h3 class="text-3xl md:text-5xl font-bold text-indigo-950 mb-4 md:mb-6">Recursos Humanos</h3>
                <p class="text-base md:text-lg text-indigo-950 text-justify">Desde o recrutamento e integração até ao desenvolvimento pessoal e profissional, o nosso foco está em criar um ambiente saudável, colaborativo e motivador.</p>
            </div>
            <div class="flex flex-col items-center md:items-end">
                <div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center shadow-lg">
                    <Image src={martaMartins} alt="Diretor" class="object-cover object-center w-full h-full transform scale-140" />
                </div>
                <p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Marta Martins</p>
                <p class="text-sm md:text-base text-gray-600 italic">Diretora Recursos Humanos</p>
            </div>
        </div>

        <div class="relative group px-4 md:px-12">
            
            <button onclick="document.getElementById('RH-carousel').scrollBy({left: window.innerWidth < 768 ? -250 : -400, behavior: 'smooth'})" 
                class="flex items-center justify-center absolute left-2 md:left-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            </button>

            <button onclick="document.getElementById('RH-carousel').scrollBy({left: window.innerWidth < 768 ? 250 : 400, behavior: 'smooth'})" 
                class="flex items-center justify-center absolute right-2 md:right-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </button>

            <div id="RH-carousel" class="flex overflow-x-auto gap-6 md:gap-8 pb-10 snap-x snap-mandatory scroll-smooth ">
                
                <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                    <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                        <Image src={martaMartins} alt="Marta Martins" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <h5 class="text-indigo-950 font-bold text-base md:text-lg">Marta Martins</h5>
                </div>

                <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                    <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                        <Image src={leonorAlmeida} alt="Leonor Almeida" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <h5 class="text-indigo-950 font-bold text-base md:text-lg">Leonor Almeida</h5>
                </div>

                <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                    <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                        <Image src={tomasGomes} alt="Tomás Gomes" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <h5 class="text-indigo-950 font-bold text-base md:text-lg">Tomás Gomes</h5>
                </div>

            </div>
        </div>
    </div>
    </section>

    <section id="financeiro" class="w-full bg-white py-16 md:py-26">
        <div class="mx-auto max-w-screen-xl px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-16 md:mb-24">
                <div>
                    <h3 class="text-3xl md:text-5xl font-bold text-indigo-950 mb-4 md:mb-6">Financeiro</h3>
                    <p class="text-base md:text-lg text-indigo-950 text-justify">É responsável pelo planeamento, controlo financeiro e acompanhamento das atividades da organização, garantindo sustentabilidade e rigor em todas as decisões.</p>
                </div>
                <div class="flex flex-col items-center md:items-end">
                    <div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center shadow-lg">
                        <Image src={catarinaMagalhaes} alt="Diretor" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Catarina Magalhães</p>
                    <p class="text-sm md:text-base text-gray-600 italic">Diretora Financeiro</p>
                </div>
            </div>

            <div class="relative group px-4 md:px-12">
                <button onclick="document.getElementById('financeiro-carousel').scrollBy({left: window.innerWidth < 768 ? -250 : -400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute left-2 md:left-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <button onclick="document.getElementById('financeiro-carousel').scrollBy({left: window.innerWidth < 768 ? 250 : 400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute right-2 md:right-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>

                <div id="financeiro-carousel" class="flex overflow-x-auto gap-8 pb-10 snap-x snap-mandatory scroll-smooth ">
                    
                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={catarinaMagalhaes} alt="Catarina Magalhães" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-base md:text-lg">Catarina Magalhães</h5>
                    </div>

                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={pedroCarneiro} alt="Pedro Carneiro" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-base md:text-lg">Pedro Carneiro</h5>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <section id="educacao-formacao" class="w-full bg-white py-16 md:py-26">
        <div class="mx-auto max-w-screen-xl px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-16 md:mb-24">
                <div>
                    <h3 class="text-3xl md:text-5xl font-bold text-indigo-950 mb-4 md:mb-6">Educação e Formação</h3>
                    <p class="text-base md:text-lg text-indigo-950 text-justify">Responsável pela organização e coordenação de iniciativas de formação internas e externas, de workshops, sessões formativas e parcerias.</p>
                </div>
                <div class="flex flex-col items-center md:items-end">
                    <div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center shadow-lg">
                        <Image src={filipaJose} alt="Diretor" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Filipa José</p>
                    <p class="text-sm md:text-base text-gray-600 italic">Diretora Educação e Formação</p>
                </div>
            </div>

            <div class="relative group px-4 md:px-12">
                <button onclick="document.getElementById('Educação-carousel').scrollBy({left: window.innerWidth < 768 ? -250 : -400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute left-2 md:left-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <button onclick="document.getElementById('Educação-carousel').scrollBy({left: window.innerWidth < 768 ? 250 : 400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute right-2 md:right-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>

                <div id="Educação-carousel" class="flex overflow-x-auto gap-8 pb-10 snap-x snap-mandatory scroll-smooth ">                    

                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={filipaJose} alt="Filipa José" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-base md:text-lg">Filipa José</h5>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <section id="projetos-analise-dados" class="w-full bg-white py-16 md:py-26">
        <div class="mx-auto max-w-screen-xl px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-16 md:mb-24">
                <div>
                    <h3 class="text-2xl md:text-5xl font-bold text-indigo-950 mb-4 md:mb-6 md:whitespace-nowrap">Projetos e Análise de Dados</h3>
                    <p class="text-base md:text-lg text-indigo-950 text-justify">Atua na análise, tratamento e interpretação de dados, transformando informação em soluções ajustadas às necessidades de cada desafio. Trabalha em estreita colaboração com clientes e parceiros.</p>
                </div>
                <div class="flex flex-col items-center md:items-end">
                    <div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center shadow-lg">
                        <Image src={sofiaLourosa} alt="Diretor" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Sofia Lourosa</p>
                    <p class="text-sm md:text-base text-gray-600 italic">Diretora Projetos e Análise de Dados</p>
                </div>
            </div>

            <div class="relative group px-4 md:px-12">
                <button onclick="document.getElementById('PAD-carousel').scrollBy({left: window.innerWidth < 768 ? -250 : -400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute left-2 md:left-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <button onclick="document.getElementById('PAD-carousel').scrollBy({left: window.innerWidth < 768 ? 250 : 400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute right-2 md:right-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>

                <div id="PAD-carousel" class="flex overflow-x-auto gap-8 pb-10 snap-x snap-mandatory scroll-smooth ">
                    
                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-48 h-48 rounded-full overflow-hidden bg-gray-100 mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={sofiaLourosa} alt="Sofia Lourosa" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-lg">Sofia Lourosa</h5>
                    </div>

                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={franciscoRibeiro} alt="Francisco Ribeiro" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-base md:text-lg">Francisco Ribeiro</h5>
                    </div>

                    <div class="flex-none w-full sm:w-1/2 md:w-[calc((100%-6rem)/4)] snap-start flex flex-col items-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden bg-gray-100 mb-3 md:mb-4 shadow-md hover:shadow-xl duration-300">
                            <Image src={goncaloPereira} alt="Gonçalo Pereira" class="object-cover object-center w-full h-full transform scale-140" />
                        </div>
                        <h5 class="text-indigo-950 font-bold text-base md:text-lg">Gonçalo Pereira</h5>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <section id="marketing" class="w-full bg-white py-16 md:py-26">
        <div class="mx-auto max-w-screen-xl px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-16 md:mb-24">
                <div>
                    <h3 class="text-3xl md:text-5xl font-bold text-indigo-950 mb-4 md:mb-6">Marketing</h3>
                    <p class="text-base md:text-lg text-indigo-950 text-justify">O departamento de Marketing é responsável pela comunicação e imagem. Atua na definição da identidade da organização, na gestão dos canais digitais e na criação de conteúdos.</p>
                </div>
                <div class="flex flex-col items-center md:items-end">
                    <div class="w-56 h-56 md:w-64 md:h-64 bg-gray-200 rounded-full overflow-hidden flex items-center justify-center shadow-lg">
                        <Image src={sofiaTumanova} alt="Diretor" class="object-cover object-center w-full h-full transform scale-140" />
                    </div>
                    <p class="mt-4 text-indigo-950 font-bold text-lg md:text-xl">Sofia Tumanova</p>
                    <p class="text-sm md:text-base text-gray-600 italic">Diretora Marketing</p>
                </div>
            </div>

            <div class="relative group px-4 md:px-12">
                <button onclick="document.getElementById('Mark-carousel').scrollBy({left: window.innerWidth < 768 ? -250 : -400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute left-2 md:left-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <button onclick="document.getElementById('Mark-carousel').scrollBy({left: window.innerWidth < 768 ? 250 : 400, behavior: 'smooth'})" 
                    class="flex items-center justify-center absolute right-2 md:right-0 top-16 md:top-24 -translate-y-1/2 z-20 p-2 md:p-3 rounded-full border border-indigo-950 text-indigo-950 bg-white shadow-md hover:bg-indigo-950 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
