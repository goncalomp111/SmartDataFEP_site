---
import Layout from '../layouts/Layout.astro';
import QuestionarioWizard from '../components/QuestionarioWizard.astro';
import { DEPARTAMENTOS, ORDEM_DEPARTAMENTOS, PERGUNTAS } from '../data/questionario';

// Define como 'true' durante a fase de recrutamento e 'false' quando estiver fechado
const candidaturasAbertas = false;

const departamentos = ORDEM_DEPARTAMENTOS.map((id) => DEPARTAMENTOS[id]);
---

<Layout title="Descobre o teu Departamento - SmartData FEP">
  <!-- ===================== Hero ===================== -->
  <section
    class="relative overflow-hidden bg-[#1e1b4b] px-4 pt-12 pb-12 text-white md:px-6 md:pt-28 md:pb-32"
  >
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-[url('/src/assets/home/images/smart_backgroud.png')] bg-cover bg-center opacity-100 mix-blend-overlay"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#1e1b4b] via-[#1e1b4b]/90 to-transparent"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-screen-xl px-4 md:px-10">
      <div>
        <div class="mb-6 inline-block border-l-4 border-blue-400 pl-4 md:mb-8">
          <span
            class="text-xs font-semibold uppercase tracking-widest text-blue-200 md:text-sm"
            >Recrutamento</span
          >
        </div>

        <h1
          class="max-w-5xl text-3xl font-medium leading-tight md:text-6xl lg:text-6xl"
        >
          Where do YOU <span
            class="bg-gradient-to-r from-blue-200 to-indigo-400 bg-clip-text text-transparent"
            >belong</span
          >?
        </h1>

        <p
          class="mt-6 max-w-3xl text-lg font-light leading-relaxed text-gray-300 md:mt-8 md:text-2xl"
        >
          Seis departamentos, seis formas diferentes de contribuir. Responde às nossas {PERGUNTAS.length} perguntas e descobre o teu departamento ideal na SmartData FEP.
        </p>

        <a
          href="#questionario"
          class="group relative mt-8 inline-flex items-center gap-2 overflow-hidden rounded-full bg-white px-8 py-4 text-center font-bold text-[#1e1b4b] transition-all hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] md:mt-10"
        >
          <span class="relative z-10">Começar</span>
          <svg
            class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-y-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
          >
          <div
            class="absolute inset-0 bg-blue-100 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          >
          </div>
        </a>
      </div>

      <!-- ===================== Cartão Dinâmico de Recrutamento ===================== -->
      <div class="mt-12 flex justify-end md:mt-2">
        <div class="w-full rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md shadow-2xl md:w-2/3 md:p-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">

            <!-- Lado Esquerdo do Cartão (Texto Condicional) -->
            <div class="max-w-xl">
              <div class="mb-3 inline-block border-l-4 border-blue-400 pl-3">
                <span class="text-xs font-semibold uppercase tracking-widest text-blue-200">
                  {candidaturasAbertas ? "Área do Candidato" : "Próxima Edição"}
                </span>
              </div>

              {candidaturasAbertas ? (
                <>
                  <h3 class="text-2xl font-bold leading-tight md:text-3xl">
                    Já submeteste a tua <span class="bg-gradient-to-r from-blue-200 to-indigo-400 bg-clip-text text-transparent">candidatura</span>?
                  </h3>
                  <p class="mt-2 text-sm font-light leading-relaxed text-gray-300 md:text-base">
                    Acompanha cada etapa do teu processo, consulta o feedback da equipa e sabe sempre qual é o teu próximo passo.
                  </p>
                </>
              ) : (
                <>
                  <h3 class="text-2xl font-bold leading-tight md:text-3xl">
                    Candidaturas <span class="bg-gradient-to-r from-blue-200 to-indigo-400 bg-clip-text text-transparent">brevemente</span>
                  </h3>
                  <p class="mt-2 text-sm font-light leading-relaxed text-gray-300 md:text-base">
                    O nosso processo de recrutamento encontra-se encerrado de momento. Fica atento às nossas redes ou entra em contacto para saber quando abre a próxima fase.
                  </p>
                </>
              )}
            </div>

            <!-- Lado Direito do Cartão (Botão Condicional) -->
            <div class="shrink-0">
              {candidaturasAbertas ? (
                <a
                  href="/login"
                  class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-white px-6 py-3 text-sm font-bold text-[#1e1b4b] whitespace-nowrap transition-all hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] md:text-base"
                >
                  <span class="relative z-10">Ver Estado</span>
                  <svg
                    class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                  <div class="absolute inset-0 bg-blue-100 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
                </a>
              ) : (
                <a
                  href="#fases-recrutamento"
                  class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-bold text-white whitespace-nowrap backdrop-blur-sm transition-all hover:bg-white hover:text-[#1e1b4b] hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] md:text-base"
                >
                  <span class="relative z-10">Saber Mais</span>
                  <svg
                    class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                  <div class="absolute inset-0 bg-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
                </a>
              )}
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== Departamentos ===================== -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-screen-xl px-6 md:px-10">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-[#1e1b4b] md:text-4xl">
          Os seis departamentos
        </h2>
        <p class="mx-auto max-w-2xl text-gray-600">
          Responde de maneira honesta para uma maior eficácia.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {
          departamentos.map((departamento) => (
            <article class="group relative flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
              <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

              <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
                {departamento.sigla}
              </div>

              <h3 class="mb-3 text-xl font-bold text-indigo-950">
                {departamento.nome}
              </h3>
              <p class="flex-1 text-base leading-relaxed text-gray-600">
                {departamento.descricao}
              </p>

              <a
                href={`/equipa?scrollTo=${departamento.ancora}`}
                class="mt-6 inline-flex items-center text-sm font-bold uppercase tracking-wide text-indigo-950 transition-colors hover:text-blue-700"
              >
                Ver a equipa
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Questionário ===================== -->
  <QuestionarioWizard />

<!-- ===================== Fases de Recrutamento ===================== -->
  <section id="fases-recrutamento" class="bg-white py-16 md:py-24 border-t border-gray-100">
    <div class="mx-auto max-w-screen-xl px-6 md:px-10">
      <div class="mb-12 text-center">
        <h2 class="mb-4 text-3xl font-bold text-[#1e1b4b] md:text-4xl">
          Fases de Recrutamento
        </h2>
        <p class="mx-auto max-w-2xl text-gray-600">
          Quatro etapas pensadas para te conhecermos melhor e avaliarmos o teu potencial.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        
        <!-- Fase 1 -->
        <article class="group relative flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
            1ª
          </div>

          <h3 class="mb-3 text-xl font-bold text-indigo-950">
            Preenchimento das candidaturas
          </h3>
          <p class="flex-1 text-base leading-relaxed text-gray-600">
            Nesta fase inicial pedimos que preenchas um formulário onde indicas alguns dados essenciais, as tuas preferências e motivações.
          </p>
        </article>

        <!-- Fase 2 -->
        <article class="group relative flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
            2ª
          </div>

          <h3 class="mb-3 text-xl font-bold text-indigo-950">
            Dinâmicas de grupo
          </h3>
          <p class="flex-1 text-base leading-relaxed text-gray-600">
            Trabalharás em grupo com outros candidatos em vários desafios práticos.
          </p>
        </article>

        <!-- Fase 3 -->
        <article class="group relative flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
            3ª
          </div>

          <h3 class="mb-3 text-xl font-bold text-indigo-950">
            Entrevistas Individuais
          </h3>
          <p class="flex-1 text-base leading-relaxed text-gray-600">
            Serás encaminhado para um departamento e terás uma entrevista com o Diretor de departamento, centrada em conhecer-te melhor e avaliar o teu perfil.
          </p>
        </article>

        <!-- Fase 4 -->
        <article class="group relative flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="absolute top-0 left-0 h-1.5 w-full rounded-t-2xl bg-[#1e1b4b] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#1e1b4b] text-sm font-bold text-[#1e1b4b] transition-all duration-300 group-hover:bg-[#1e1b4b] group-hover:text-white">
            4ª
          </div>

          <h3 class="mb-3 text-xl font-bold text-indigo-950">
            Dinâmicas finais
          </h3>
          <p class="flex-1 text-base leading-relaxed text-gray-600">
            Participarás em desafios com a equipa do teu departamento, num momento destinado a avaliar a tua integração e a tua capacidade de responder às exigências do trabalho a ser desenvolvido.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- ===================== Fecho ===================== -->
  <section class="border-y border-gray-200 bg-white py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="mb-4 text-2xl font-bold text-[#1e1b4b] md:text-3xl">
        Ficaste com dúvidas?
      </h2>
      <p class="mb-8 text-base leading-relaxed text-gray-600 md:text-lg">
        O resultado é só um ponto de partida. Se quiseres perceber melhor o que
        se faz no dia a dia de cada departamento, fala connosco — respondemos
        sempre.
      </p>
      <a
        href="/contactos"
        class="inline-flex items-center justify-center rounded-full border border-[#1e1b4b] bg-[#1e1b4b] px-8 py-4 font-bold text-white transition-all hover:bg-[#1e1b4b]/90"
      >
        Falar connosco
      </a>
    </div>
  </section>
</Layout>